# Ignore everything
*

# Unignore the folders and files you care about
!src/
!src/**/
!src/**/*.cpp
!src/**/*.hpp
!src/**/*.h
!src/**/*.c

!examples/
!examples/**/
!examples/**/*.cpp
!examples/**/*.hpp
!examples/**/*.h

!CMakeLists.txt

# Also unignore .gitignore itself and .clang-format if you want
!.gitignore
!.clang-format