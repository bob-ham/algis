{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug",
            "type": "shell",
            "command": "C:\\Program Files\\LLVM\\bin\\clang++.exe",
            "args": [
                "-g",
                "-O0",
                "-std=c++23",
                "-Wall",
                "-Wextra",
                "-fcolor-diagnostics",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}_d.exe"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            }
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "C:\\Program Files\\LLVM\\bin\\clang++.exe",
            "args": [
                "-O2",
                "-DNDEBUG",
                "-std=c++23",
                "-ffunction-sections",
                "-fdata-sections",
                "-Wl,--gc-sections",
                "-Wl,-s",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": "build",
            "problemMatcher": "$gcc",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            }
        }
    ]
}